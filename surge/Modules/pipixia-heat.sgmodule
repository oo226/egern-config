#!name=皮皮虾防烫（Surge）
#!desc=heat7 202608211002 · log-api假200停烫机
# UPDATE-MARKER heat7-202608211002
#!category=Surge专用

# 大合集经常「已是最新」刷不动时，单独装本小模块即可。
# 与去广告合集可同时开；本模块只处理烫机埋点。
# 硬 REJECT / URL Rewrite - reject 会让 App 立刻重试，最近请求一直跳。
# 假 200（reject-200 + Map Local）让 SDK 以为上报成功。
# i-lq.snssdk.com/service/settings 不要假空包，否则配置拉取失败仍会狂重试。

[URL Rewrite]
^https?:\/\/log-api\.pangolin-sdk-toutiao[-\w]*\.com\/.* - reject-200
^https?:\/\/api-access\.pangolin-sdk-toutiao[-\w]*\.com\/.* - reject-200
^https?:\/\/gromore\.pangolin-sdk-toutiao[-\w]*\.com\/.* - reject-200
^https?:\/\/mon\.snssdk\.com\/.* - reject-200
^https?:\/\/mon\.zijieapi\.com\/.* - reject-200
^https?:\/\/toblog\.ctobsnssdk\.com\/.* - reject-200
^https?:\/\/sdk\.e\.qq\.com - reject-200
^https?:\/\/snowflake\.qq\.com\/ola - reject-200
^https?:\/\/mobads-logs\.baidu\.com\/.* - reject-200

[Map Local]
# heat6：app_log 假成功，停狂重试烫机
^https?:\/\/log-api\.pangolin-sdk-toutiao[-\w]*\.com\/service\/2\/app_log data-type=text data="{\"code\":0,\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/log-api\.pangolin-sdk-toutiao[-\w]*\.com data-type=text data="{\"code\":0,\"message\":\"success\"}" status-code=200 header="Content-Type:application/json"
# 与 toblog 同款：假 200，避免走代理 EOF 狂重试
^https?:\/\/mon\.snssdk\.com\/monitor data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mon\.zijieapi\.com data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/toblog\.ctobsnssdk\.com data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/sdk\.e\.qq\.com data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/snowflake\.qq\.com\/ola data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mobads-logs\.baidu\.com data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api-access\.pangolin-sdk-toutiao[-\w]*\.com\/api\/ad\/union\/sdk\/stats data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Rule]
# 不要硬 REJECT 这些域名（会重试烫机）；交给上面 Map Local / reject-200
DOMAIN,mon.snssdk.com,DIRECT
DOMAIN,mon.zijieapi.com,DIRECT
DOMAIN,toblog.ctobsnssdk.com,DIRECT
DOMAIN,i-lq.snssdk.com,DIRECT
DOMAIN,log-api.pangolin-sdk-toutiao.com,DIRECT
DOMAIN,log-api.pangolin-sdk-toutiao1.com,DIRECT

[MITM]
hostname = %APPEND% log-api.pangolin-sdk-toutiao.com, log-api.pangolin-sdk-toutiao1.com, api-access.pangolin-sdk-toutiao.com, api-access.pangolin-sdk-toutiao1.com, gromore.pangolin-sdk-toutiao.com, mon.snssdk.com, mon.zijieapi.com, toblog.ctobsnssdk.com, i-lq.snssdk.com, sdk.e.qq.com, snowflake.qq.com, mobads-logs.baidu.com
