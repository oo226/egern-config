#!name=Telegram 防烫（Surge）
#!desc=heat11 · 跳过裸 IP MitM，打断 MitM Failed 狂重试
# UPDATE-MARKER heat11-tg-mitm
#!category=Surge专用

# 最近请求里 194.221.250.50 / 91.108.* / 149.154.* 狂刷 MitM Failed → 烫机。
# 根因：Telegram 用裸 IP + 证书钉扎；解密必失败然后立刻重试。
#
# 注意：排除项必须出现在最终 hostname 列表「最前面」。
# 本模块用 %INSERT% 无效时请直接更新主配置 Surge.conf（已含 -<ip-address>:0）。
# 若你开了「解密全部 HTTPS」（hostname 含 *），务必保证主配置排除在 * 之前。

[MITM]
hostname = %APPEND% -<ip-address>:0, -*.telegram.org, -*.telegram-cdn.org, -*.t.me, -*.whatsapp.com, -*.whatsapp.net, -*.wa.me
