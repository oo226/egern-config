#!name=起点读书签到
#!desc=Yuheng 官方 Surge 模块镜像。装模块后靠 MITM 抓CK + cron 自动签；Surge 不能点模块里的脚本手动跑。
#!author=Yuheng0101[https://github.com/Yuheng0101]
#!homepage=https://github.com/Yuheng0101/X
#!category=签到
#!arguments=是否开启抓取重写:"起点读书", CRONEXP:"11 2 * * *",是否开启调试模式:false,TIMEOUT:60,是否开启激励任务:false,是否开启每日任务:false,是否开启每日抽奖:false,是否开启每周兑换:false,是否开启章节卡片:false,是否开启大咖荐书:false
#!arguments-desc=- 是否开启抓取重写: ["起点读书","#"] \n\n- CRONEXP: 默认每天2点11分\n\n- 是否开启调试模式: ["true","false"]\n\n- TIMEOUT: 默认60秒\n\n其它任务开关默认 false。抓完 CK 务必将「是否开启抓取重写」改成 #。

[Script]
{{{是否开启抓取重写}}}获取Cookie = type=http-response,pattern=^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/yuheng/Tasks/QDReader/qdreader.js,argument=QDREADER_DEBUG="{{{是否开启调试模式}}}"

起点读书自动签到 = type=cron, cronexp="{{{CRONEXP}}}", script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/yuheng/Tasks/QDReader/qdreader.js, timeout={{{TIMEOUT}}},argument=QDREADER_DEBUG="{{{是否开启调试模式}}}"&QDREADER_ADV_JOB_ENABLE="{{{是否开启激励任务}}}"&QDREADER_EXTRA_ADV_JOB_ENABLE="{{{是否开启每日任务}}}"&QDREADER_LOTTERY_ENABLE="{{{是否开启每日抽奖}}}"&QDREADER_WEEKLY_EXCHANGE_ENABLE="{{{是否开启每周兑换}}}"&QDREADER_CHAPTER_CARD_ENABLE="{{{是否开启章节卡片}}}"&QDREADER_MESSAGE_BOX_ENABLE="{{{是否开启大咖荐书}}}"

[MITM]
hostname = %APPEND% h5.if.qidian.com
