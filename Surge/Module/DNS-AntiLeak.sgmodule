#!name=DNS 防侧漏
#!desc=去掉 system 运营商 DNS；国内明文+阿里 DoH；hijack *:53。给有喵原版 CN/EN 等未改 General 的配置用。CN-Plus 主配置已内置同等项，可不必再开。
#!category=Surge-Plus

[General]
# 勿加 system：否则 browserleaks 一片「中国移动」+ IPv6 2409:8028
dns-server = 223.5.5.5, 119.29.29.29
encrypted-dns-server = https://223.5.5.5/dns-query
hijack-dns = *:53, 8.8.8.8:53, 8.8.4.4:53, 1.1.1.1:53, 1.0.0.1:53, 114.114.114.114:53
ipv6 = false
ipv6-vif = disabled
