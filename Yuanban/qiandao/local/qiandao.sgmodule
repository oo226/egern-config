#!name=签到合集
#!desc=PingMe + 起点读书。抓参默认关（填 #）；要抓参时把对应项改成「PingMe抓参」或「起点读书」，抓完改回 #。
#!author=怎么肥事 / Yuheng / oo226
#!homepage=https://github.com/oo226/egern-config
#!category=签到
#!system=ios
#!tag=签到,PingMe,起点
#!arguments=PingMe抓参:"#",起点抓参:"#",PingMeCRON:"30 8,20 * * *",起点CRON:"11 2 * * *",TIMEOUT:300,是否开启调试模式:false,是否开启激励任务:false,是否开启每日任务:false,是否开启每日抽奖:false,是否开启每周兑换:false,是否开启章节卡片:false,是否开启大咖荐书:false
#!arguments-desc=- PingMe抓参: ["PingMe抓参","#"] 开抓参→打开 PingMe→改回 #\n- 起点抓参: ["起点读书","#"] 开抓参→打开起点→改回 #\n- PingMeCRON / 起点CRON: 定时\n- TIMEOUT: 超时秒数\n- 其余为起点任务开关\n\n单件仍在 local/pingme.yaml、local/qdreader.sgmodule。

[Script]
{{{PingMe抓参}}}PingMe获取参数 = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/qiandao/js/PingMe-cook.js,timeout=60

PingMe签到 = type=cron,cronexp="{{{PingMeCRON}}}",script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/qiandao/js/PingMe.js,timeout={{{TIMEOUT}}}

{{{起点抓参}}}起点获取Cookie = type=http-response,pattern=^https?:\/\/h5\.if\.qidian\.com\/argus\/api\/v1\/user\/getlogininfo,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/zuozhe/local/js/qdreader.js,argument=QDREADER_DEBUG="{{{是否开启调试模式}}}"

起点读书自动签到 = type=cron,cronexp="{{{起点CRON}}}",script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/zuozhe/local/js/qdreader.js,timeout={{{TIMEOUT}}},argument=QDREADER_DEBUG="{{{是否开启调试模式}}}"&QDREADER_ADV_JOB_ENABLE="{{{是否开启激励任务}}}"&QDREADER_EXTRA_ADV_JOB_ENABLE="{{{是否开启每日任务}}}"&QDREADER_LOTTERY_ENABLE="{{{是否开启每日抽奖}}}"&QDREADER_WEEKLY_EXCHANGE_ENABLE="{{{是否开启每周兑换}}}"&QDREADER_CHAPTER_CARD_ENABLE="{{{是否开启章节卡片}}}"&QDREADER_MESSAGE_BOX_ENABLE="{{{是否开启大咖荐书}}}"

[MITM]
hostname = %APPEND% api.pingmeapp.net, h5.if.qidian.com
