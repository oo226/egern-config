#!name=PingMe
#!desc=PingMe 抓参 + 定时签到（Surge/Egern 通用 .sgmodule）。先开抓参→打开 App→改成 #→等 cron。签名对齐 quanx 原版。
#!author=怎么肥事 / fmz200 / oo226
#!homepage=https://github.com/oo226/egern-config
#!category=签到
#!system=ios
#!tag=PingMe,签到,抓参,模版参数
#!arguments=是否开启抓取重写:"PingMe抓参",CRONEXP:"30 8,20 * * *",TIMEOUT:300
#!arguments-desc=- 是否开启抓取重写: ["PingMe抓参","#"]\n  填 PingMe抓参=开抓参；填 #=关抓参（抓完务必改）。\n\n- CRONEXP: 签到定时，默认每天 8:30 与 20:30。\n\n- TIMEOUT: 签到超时秒数，默认 300。\n\nEgern 更推荐装 pingme.yaml（原生）；本 sgmodule 给 Surge/兼容用。MITM 需含 api.pingmeapp.net。

[Script]
{{{是否开启抓取重写}}}获取参数 = type=http-request,pattern=^https:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus,script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/qiandao/js/PingMe-cook.js,timeout=60

PingMe签到 = type=cron,cronexp="{{{CRONEXP}}}",script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/qiandao/js/PingMe.js,timeout={{{TIMEOUT}}}

[MITM]
hostname = %APPEND% api.pingmeapp.net
