# --- 18pcs.js ---
18pcs_1 = type=http-request, pattern=^https?:\/\/18pcs.(fun|bond|cfd)\/record\/\d+ url, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/zuozhe/weigiegie/js/18pcs.js, requires-body=true, max-size=-1, timeout=60
# --- 18top.js ---
18top_1 = type=http-request, pattern=^https?:\/\/(boylove|toptoon).(online|click|cyou|monster)\/(buychapter|comic\/\d+) url, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/guize/Yuanban/zuozhe/weigiegie/js/18top.js, requires-body=true, max-size=-1, timeout=60
