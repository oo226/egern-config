#!name=本地解锁补全
#!desc=屏蔽系统更新下载；点进更新页会「无法检查」属预期。勿拒 xp.apple.com（会卡 TestFlight）。不含 P12/OCSP 屏蔽（避免企业证书掉签）
#!author=oo226/egern-config (规则源自 BlueGrave/Surge、社区惯例)
#!category=解锁补全
#!system=ios

[Rule]
# 农行代理检测探针（原 skip-proxy-collection；skip-proxy 名单已收敛到主配置）
DOMAIN,msmp.abchina.com.cn,REJECT
# 屏蔽系统更新：硬拒后无法连苹果查清单 → 「无法检查更新」
# 说明：苹果清单有签名，Map Local 空包/假包不能稳定伪装成「已是最新」消小红点
# 不要 REJECT xp.apple.com：TestFlight / App 体验服务会一直转圈（日志里 Rule=REJECT）
# 勿拒 ocsp*.apple.com / valid.apple.com / ppq.apple.com：会干扰企业 P12 验签导致掉签
DOMAIN,ns.itunes.apple.com,REJECT
DOMAIN,gdmf.apple.com,REJECT
DOMAIN,mesu.apple.com,REJECT
DOMAIN,updates.cdn-apple.com,REJECT
DOMAIN,updates-http.cdn-apple.com,REJECT
DOMAIN-SUFFIX,appldnld.apple.com,REJECT
DOMAIN-SUFFIX,mesu-cdn.apple.com.akadns.net,REJECT
# 勿拒 configuration.apple.com：系统会连打重试，最近请求里一串 REJECT
DOMAIN,swscan.apple.com,REJECT
DOMAIN,swdist.apple.com,REJECT
DOMAIN,swdownload.apple.com,REJECT

[MITM]
skip-server-cert-verify = true
