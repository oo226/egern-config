# 老书 · 综合电商去广告
# - - - - - - - - - - - - - - - - - - - - - - - - 
# ================= JQ 数据处理 =================
# 快手
http-response-jq ^https:\/\/.*\.(ksapisrv|gifshow)\.com\/rest\/n\/(reskinConfig|sidebarExSquareStyle) 'delpaths([["reskinConfig"],["sidebarExSquareStyle","moreList"],["sidebarExSquareStyle","topList"]]) | .data.sidebarExSquareStyle.commonlyUsedList? |= map(select(.title as $t | $t != "设置" and $t != "历史记录" and $t != "草稿箱" and $t != "我的钱包" and $t != "小程序" and $t != "未成年人模式" and $t != "官方客服" and $t != "内容偏好" and $t != "离线模式" and $t != "稍后再看" and $t != "举报中心" and $t != "挂件"))'
http-response-jq ^https:\/\/.*\.(ksapisrv|gifshow)\.com\/rest\/n\/live\/feed\/square\/refresh 'del(.data.banners)'
http-response-jq ^https:\/\/.*\.(ksapisrv|gifshow)\.com\/rest\/n\/feed\/(selection|selectionFast) '.data.items? |= map(select(.ad != true))'
http-response-jq ^https:\/\/.*\.(ksapisrv|gifshow)\.com\/rest\/n\/user\/profile\/v2 'del(.data.postRecommends)'

# 拼多多
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? 'delpaths([["result","dy_module","irregular_banner_dy"],["result","icon_set"],["result","search_bar_hot_query"]]) | .result.bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html")))'
http-response-jq ^https:\/\/api\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'delpaths([["monthly_card_entrance"],["personal_center_style_v2_vo"],["icon_set","icons"],["icon_set","top_personal_icons"]])'

# 闲鱼
http-response-jq ^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlehome\.home\.nextfresh\/ '.data.homeTopList |= map(select(.sectionType == "kingkongDo")) | .data.sections |= map(select((.data.clickParam.args.cardType as $ct | $ct != "homeMultiBanner" and $ct != "mamaAD")))'

# 美团
http-response-jq ^https:\/\/rms\.meituan\.com\/api\/v\d\/rmsmina\/c\/queryShopPortalInfo\? 'delpaths([["data","popUpWindows"]])'


# - - - - - - - - - - - - - - - - - - - - - - - - 
# 老书 · 音乐流媒体净化
# - - - - - - - - - - - - - - - - - - - - - - - - 
# URL 快速拦截（仅保留未被上方 DOMAIN REJECT 覆盖、非冗余的条目）
^https?:\/\/splash\.kugou\.com\/.* reject
^https?:\/\/.*\.kuwo\.cn\/openapi\/v1\/app\/pasterAd reject

# ================= Body JQ 深度净化 =================
# 汽水音乐
http-response-jq ^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/me\? 'del(.reward_ad_banner)'
http-response-jq ^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/card\? 'del(.preview_guide) | if .card_items then .card_items[0].priority_display = false | .card_items[0].is_show = false else . end'
http-response-jq ^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/search-block 'del(.search_chart_block)'
http-response-jq ^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/activities 'del(.activity_map)'
http-response-jq ^https:\/\/(beta-luna\.douyin\.com|api\.qishui\.com)\/luna\/feed\/song-tab '.items |= map(select(.type == "track"))'

# 喜马拉雅
http-response-jq ^https:\/\/(mobile|mobilehera|mobwsa)\.ximalaya\.com\/mobile-user\/v\d\/homePage\/ 'del(.data.freeListenV2) | if .data.serviceModule.entrances then .data.serviceModule.entrances |= map(select(.name == "全部服务")) else . end'

# 蜻蜓FM
http-response-jq ^https:\/\/app\.qtfm\.cn\/m-bff\/v\d\/signin\/show_homepage_icon$ 'if (getpath(["data"]) | has("display_icon")) then (setpath(["data","display_icon"]; false)) else . end'
http-response-jq ^https:\/\/app\.qtfm\.cn\/recommendapi\/v\d\/hotpage\? '.data.head |= map(select(.type == "IconGrid")) | .data.feeds |= map(select(.type == "Channel" or .type == "Radio" or .type == "ListenListChannel"))'

# 猫耳FM
http-response-jq ^https:\/\/app\.missevan\.com\/site\/launch\? 'delpaths([["info","splash"],["info","splash_ready"]])'
http-response-jq ^https:\/\/app\.missevan\.com\/site\/config$ 'delpaths([["info","tab_bar_live"],["info","enable_tab_bar_live_notice"],["info","teenager_popup_mode"],["info","httpdns"],["info","homepage_top_task_button"]]) | .info.cronet |= (fromjson | .quic=false | tojson)'
