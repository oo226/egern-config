#!name=TestFlight 解卡
#!desc=tf2：强制 DIRECT + 排除 MitM。装完请关掉其它「TestFlight/iRingo TF」模块，杀 TF 后台再开 join 链接
#!author=oo226/egern-config
#!category=解锁补全
#!system=ios

[General]
# TF / App 安装包走直连，避免被代理或 MitM
skip-proxy = %APPEND% testflight.apple.com, iosapps.itunes.apple.com, xp.apple.com

[Rule]
# 若解锁合集仍拒这些域名，本模块需装在其后或重装解锁合集；优先直连
DOMAIN,xp.apple.com,DIRECT,extended-matching
DOMAIN,testflight.apple.com,DIRECT,extended-matching
DOMAIN-SUFFIX,testflight.apple.com,DIRECT,extended-matching
DOMAIN,fpinit.itunes.apple.com,DIRECT,extended-matching
DOMAIN-SUFFIX,gc.apple.com,DIRECT,extended-matching
DOMAIN,init.gc.apple.com,DIRECT,extended-matching
DOMAIN,static.gc.apple.com,DIRECT,extended-matching
DOMAIN,profile.gc.apple.com,DIRECT,extended-matching
DOMAIN,ns.itunes.apple.com,DIRECT,extended-matching
DOMAIN,configuration.apple.com,DIRECT,extended-matching

[MITM]
# 排除其它模块对 TF 的 MitM（Surge 支持 -hostname 取消解密）
hostname = %APPEND% -testflight.apple.com
