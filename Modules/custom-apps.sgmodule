DOMAIN-SUFFIX,cdnhwc8.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,ctyunxs.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,e.kuaishou.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,eos.huhehaote-8.cmecloud.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,gepush.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,gifshow.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,static-dsp.8ziben.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,static.fliduo.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,yximgs.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,yxings.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,zhangyuyidong.cn,REJECT,pre-matching # @keep
DOMAIN,open.e.kuaishou.cn,REJECT,pre-matching # @keep
DOMAIN,sdk.zhangyuyidong.cn,REJECT,pre-matching # @keep
DOMAIN,v66-ad.ndcjl.com,REJECT,pre-matching # @keep
# 得力e+ / 开屏 SDK
DOMAIN-KEYWORD,delicloud-operate-manager,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,hzzfcm.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,66mobi.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,adn-plus.com.cn,REJECT,pre-matching # @keep
# NBPro 墨鱼版补充 SDK（ddgksf2013/NBProAds.conf）
DOMAIN,capsinfo.anythink.com,REJECT,pre-matching # @keep
DOMAIN,showtime.anythink.com,REJECT,pre-matching # @keep
DOMAIN,api.bridgeoos.com,REJECT,pre-matching # @keep
DOMAIN,pitk.birdgesdk.com,REJECT,pre-matching # @keep
DOMAIN,aa.birdgesdk.com,REJECT,pre-matching # @keep
DOMAIN,fusion-static.oss-cn-shenzhen.aliyuncs.com,REJECT,pre-matching # @keep
DOMAIN,mobads.baidu.com,REJECT,pre-matching # @keep
DOMAIN,cpu.baidu.com,REJECT,pre-matching # @keep
DOMAIN,cpu-openapi.baidu.com,REJECT,pre-matching # @keep
DOMAIN,mobads-pre-config.bj.bcebos.com,REJECT,pre-matching # @keep
DOMAIN,mobads-pre-config.cdn.bcebos.com,REJECT,pre-matching # @keep
DOMAIN,cpro.baidustatic.com,REJECT,pre-matching # @keep
DOMAIN,render-server.cdn.bcebos.com,REJECT,pre-matching # @keep
DOMAIN,adservice.sigmob.cn,REJECT,pre-matching # @keep
DOMAIN,api.htp.ad-scope.com.cn,REJECT,pre-matching # @keep
DOMAIN,bid.ad-scope.com.cn,REJECT,pre-matching # @keep
DOMAIN,api-htp.beizi.biz,REJECT,pre-matching # @keep
DOMAIN,sdk.beizi.biz,REJECT,pre-matching # @keep
DOMAIN,sdktmp.hubcloud.com.cn,REJECT,pre-matching # @keep
DOMAIN,sdk6.zhangyuyidong.cn,REJECT,pre-matching # @keep
DOMAIN,sdkcfg.adintl.cn,REJECT,pre-matching # @keep
DOMAIN,test.s.adintl.cn,REJECT,pre-matching # @keep
DOMAIN,api-incentive.8ziben.com,REJECT,pre-matching # @keep
DOMAIN,static.8ziben.com,REJECT,pre-matching # @keep
DOMAIN,opehs.tanx.com,REJECT,pre-matching # @keep
DOMAIN,videoproxy.tanx.com,REJECT,pre-matching # @keep
DOMAIN,c.etoolads.cn,REJECT,pre-matching # @keep
DOMAIN,sdk.adx.adwangmai.com,REJECT,pre-matching # @keep
DOMAIN,sdk-cfg.adx.adwangmai.com,REJECT,pre-matching # @keep
DOMAIN,static.adwangmai.com,REJECT,pre-matching # @keep
DOMAIN,open.e.kuaishou.com,REJECT,pre-matching # @keep
DOMAIN,s.e.kuaishou.com,REJECT,pre-matching # @keep
# 微信公众号/小程序广告素材 CDN（Lentin；勿整域拒 wxs.qq.com，免误伤正文图）
DOMAIN,wxa.wxs.qq.com,REJECT,pre-matching # @keep
DOMAIN,wximg.wxs.qq.com,REJECT,pre-matching # @keep
DOMAIN,wxsmw.wxs.qq.com,REJECT,pre-matching # @keep
# NB 控制口勿 AND REJECT：/nb/telnet=Network OK；/nb/app 用脚本改广告字段

[URL Rewrite]
# 邮储银行（与奶思合集互补，确保子域 MITM 生效）
^https?:\/\/static\.mobile-bank\.psbc\.com\/mgs - reject

# 动卡空间开屏（中信）
^https?:\/\/ump\.sz\.creditcard\.ecitic\.com\/citiccard\/cm-ump\/ump-gateway\/ump-net-app\/ump-net-app\/adv data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/m\.creditcard\.ecitic\.com\/citiccard\/mbk\/appspace-getway\/getWay\/dkkj-system-web\/system\/v\d+\/init-config data-type=text data=" " status-code=200




# NB全能助手 / NB Pro — 只拒开屏路径；telnet 假成功；/nb/app 走脚本（墨鱼 NBProAds）
^https?:\/\/(api\.|www\.|app\.)?nbtool8\.com(:\d+)?\/.*(splash|startup|launch|open[Ss]creen|welcome|banner|popup|promo|advert|/ad/|/ads/) - reject-dict
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/.*(splash|startup|launch|banner|popup|advert|/ad/|/ads/) - reject-dict
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/124\.222\.32\.246(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/117\.72\.39\.157(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/47\.243\.71\.210(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/cesapp\.goypzc\.cn(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"

# 得力e+ 混业务接口（不能整域 REJECT）→ MITM 路径级；百川 SMB 同域淘宝 H5
^https?:\/\/qt-api\.delicloud\.com\/.*(splash|startup|launch|open[Ss]creen|welcome|banner|popup|promo|advert|/ad/|/ads/|operate) - reject-dict
^https?:\/\/[^/]*\.delicloud\.com\/.*(splash|startup|launch|banner|popup|advert|/ad/|operate) - reject-dict
^https?:\/\/h5api\.m\.taobao\.com\/h5\/mtop\.taobao\.baichuan\.smb\.get - reject-dict

^https?:\/\/(mi|v|tv)\.gdt\.qq\.com\/gdt_mview\.fcg - reject-dict
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/ - reject
^https?:\/\/api-access\.pangolin-sdk-toutiao1\.com\/ - reject
^https?:\/\/open\.snssdk\.com\/api\/ad\/ - reject
^https?:\/\/is\.snssdk\.com\/api\/ad\/ - reject
^https?:\/\/api\.ks\.com\/rest\/e\/v\d+\/open\/ - reject

[Map Local]
# 微信公众号：兼容 :443 / http(s) / 无 query（对齐 QingRex；Egern 另有原生 map_locals）
^https?:\/\/mp\.weixin\.qq\.com(:\d+)?\/mp\/getappmsgad data-type=text data="{\"advertisement_num\":0,\"advertisement_info\":[]}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mp\.weixin\.qq\.com(:\d+)?\/mp\/(cps_product_info|jsmonitor|masonryfeed|relatedarticle|relatedsearchword) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# NB助手：仅 telnet=Network OK（/nb/app 用 nbpro-ads 脚本，勿空抓）
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/124\.222\.32\.246(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/117\.72\.39\.157(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/47\.243\.71\.210(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/cesapp\.goypzc\.cn(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
[Script]



# NBPro /nb/app：墨鱼版解密改广告字段再写回（勿空正文）
nbpro-ads = type=http-response, pattern=^https?:\/\/(?:[^:/]*nbtool8\.com|124\.222\.32\.246|117\.72\.39\.157|47\.243\.71\.210|cesapp\.goypzc\.cn)(?::\d+)?\/nb\/app, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/ddgksf2013/nbpro.ads.js, requires-body=true, max-size=-1, timeout=60
