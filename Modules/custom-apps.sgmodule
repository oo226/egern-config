#!name=银行·NB助手补全
#!desc=邮储/动卡 MITM；NBPro 墨鱼版 SDK REJECT + /nb/app 脚本改广告（合并进大合集）
#!author=oo226/egern-config + LYZIOS/NBToolAds + ddgksf2013/NBProAds
#!category=自定义补全
#!system=ios

[MITM]
hostname = %APPEND% static.psbc.com, mcc.psbc.com, static.mobile-bank.psbc.com, d.psbc.com, mobile-bank.psbc.com, nbtool8.com, api.nbtool8.com, www.nbtool8.com, app.nbtool8.com, cesapp.goypzc.cn, 124.222.32.246, 117.72.39.157, 47.243.71.210, qt-api.delicloud.com, *.delicloud.com

[Rule]
# NB助手 / NBToolAds (LYZIOS) — 广告 SDK 域名（# @keep：合集内双层兜底）
DOMAIN-SUFFIX,adintl.cn,REJECT,pre-matching # @keep
