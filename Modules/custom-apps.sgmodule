#!name=银行·NB助手补全
#!desc=邮储/动卡 MITM 去开屏；NB助手 NBToolAds（合并进去广告净化合集）。不含税务/邮储 skip-proxy（skip 会废 MITM）
#!author=oo226/egern-config + LYZIOS/NBToolAds
#!category=自定义补全
#!system=ios

[MITM]
hostname = %APPEND% static.psbc.com, mcc.psbc.com, static.mobile-bank.psbc.com, d.psbc.com, mobile-bank.psbc.com, nbtool8.com, api.nbtool8.com, www.nbtool8.com, app.nbtool8.com, qt-api.delicloud.com, *.delicloud.com

[Rule]
# NB助手 / NBToolAds (LYZIOS) — 广告 SDK 域名（# @keep：合集内双层兜底，防 Reject-Merged 未刷新空窗）
DOMAIN-SUFFIX,adintl.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,adkwai.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,adukwai.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,api-cfg.8ziben.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,api-dsp.8ziben.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,api-events.8ziben.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,bugly.qq.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,cdnhwc8.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,ctyunxs.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,e.kuaishou.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,eos.huhehaote-8.cmecloud.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,gepush.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,gifshow.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,static-dsp.8ziben.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,static.fliduo.cn,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,yximgs.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,yxings.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,zhangyuyidong.cn,REJECT,pre-matching # @keep
DOMAIN,open.e.kuaishou.cn,REJECT,pre-matching # @keep
DOMAIN,sdk.zhangyuyidong.cn,REJECT,pre-matching # @keep
DOMAIN,v66-ad.ndcjl.com,REJECT,pre-matching # @keep
# 得力e+ / 开屏 SDK（进合集后 divert 并入 Reject-Merged；# @keep 双层）
DOMAIN-KEYWORD,delicloud-operate-manager,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,hzzfcm.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,66mobi.com,REJECT,pre-matching # @keep
DOMAIN-SUFFIX,adn-plus.com.cn,REJECT,pre-matching # @keep
# NB 控制口勿 AND REJECT：/nb/telnet=Network OK；域名拦了会改走 124.222.32.246:80

[URL Rewrite]
# 邮储银行（与奶思合集互补，确保子域 MITM 生效）
^https?:\/\/static\.mobile-bank\.psbc\.com\/mgs - reject

# 动卡空间开屏（中信）
^https?:\/\/ump\.sz\.creditcard\.ecitic\.com\/citiccard\/cm-ump\/ump-gateway\/ump-net-app\/ump-net-app\/adv data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/m\.creditcard\.ecitic\.com\/citiccard\/mbk\/appspace-getway\/getWay\/dkkj-system-web\/system\/v\d+\/init-config data-type=text data=" " status-code=200













# NB全能助手 / NB Pro — 官方域名开屏与广告接口（须匹配 :端口，否则 9527/nb/app 漏网）
^https?:\/\/(api\.|www\.|app\.)?nbtool8\.com(:\d+)?\/.*(splash|startup|launch|open[Ss]creen|welcome|banner|popup|promo|advert|/ad/|/ads/) - reject-dict
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/.*(splash|startup|launch|banner|popup|advert|/ad/|/ads/) - reject-dict
# 控制口假成功：telnet=Network OK；app=空正文；含硬编码 IP 绕过
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/124\.222\.32\.246(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/nb\/app data-type=text data="" status-code=200 header="Content-Type:text/plain"
^https?:\/\/124\.222\.32\.246(:\d+)?\/nb\/app data-type=text data="" status-code=200 header="Content-Type:text/plain"
^https?:\/\/[^:/]*nbtool8\.com:\d+\/nb\/(?!telnet) data-type=text data="" status-code=200 header="Content-Type:text/plain"
^http:\/\/[^:/]*nbtool8\.com:\d+\/ data-type=text data="" status-code=200 header="Content-Type:text/plain"
^http:\/\/124\.222\.32\.246(:\d+)?\/ data-type=text data="" status-code=200 header="Content-Type:text/plain"

# 得力e+ 混业务接口（不能整域 REJECT）→ MITM 路径级；百川 SMB 同域淘宝 H5
^https?:\/\/qt-api\.delicloud\.com\/.*(splash|startup|launch|open[Ss]creen|welcome|banner|popup|promo|advert|/ad/|/ads/|operate) - reject-dict
^https?:\/\/[^/]*\.delicloud\.com\/.*(splash|startup|launch|banner|popup|advert|/ad/|operate) - reject-dict
^https?:\/\/h5api\.m\.taobao\.com\/h5\/mtop\.taobao\.baichuan\.smb\.get - reject-dict

^https?:\/\/(mi|v|tv)\.gdt\.qq\.com\/gdt_mview\.fcg - reject-dict
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/ - reject
^https?:\/\/api-access\.pangolin-sdk-toutiao1\.com\/ - reject
^https?:\/\/open\.snssdk\.com\/api\/ad\/ - reject
^https?:\/\/is\.snssdk\.com\/api\/ad\/ - reject
^https?:\/\/api\.ks\.com\/rest\/e\/v\d+\/open\/ - reject

[Map Local]
# 微信公众号：兼容 :443 / http(s) / 无 query（旧 \? 正则会漏命中；对齐 QingRex）
^https?:\/\/mp\.weixin\.qq\.com(:\d+)?\/mp\/getappmsgad data-type=text data="{\"advertisement_num\":0,\"advertisement_info\":[]}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mp\.weixin\.qq\.com(:\d+)?\/mp\/(cps_product_info|jsmonitor|masonryfeed|relatedarticle|relatedsearchword) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# 小程序广告素材路径兜底（整域 wxs 见 Reject-Hot）
^http:\/\/\w+\.wxs\.qq\.com\/\d+\/\d+\/(snscosdownload|snssvpdownload)\/(SH|SZ)\/reserved\/\w+ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
# NB助手：假成功去开屏（勿硬 REJECT；含 IP 绕过 124.222.32.246）
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/124\.222\.32\.246(:\d+)?\/nb\/telnet data-type=text data="Network OK" status-code=200 header="Content-Type:text/plain"
^https?:\/\/[^:/]*nbtool8\.com(:\d+)?\/nb\/app data-type=text data="" status-code=200 header="Content-Type:text/plain"
^https?:\/\/124\.222\.32\.246(:\d+)?\/nb\/app data-type=text data="" status-code=200 header="Content-Type:text/plain"
^http:\/\/[^:/]*nbtool8\.com:\d+\/ data-type=text data="" status-code=200 header="Content-Type:text/plain"
^http:\/\/124\.222\.32\.246(:\d+)?\/ data-type=text data="" status-code=200 header="Content-Type:text/plain"
