#!name=PingMe 签到
#!desc=PingMe 抓参 + 定时签到（模版参数开关抓参；Egern 下 # 会写进匹配规则以关闭抓参）
#!author=怎么肥事 / fmz200 / oo226
#!homepage=https://github.com/oo226/egern-config
#!category=签到
#!system=ios
#!tag=PingMe,签到,抓参
#!arguments=是否开启抓取重写:"^https://api\\.pingmeapp\\.net/app/queryBalanceAndBonus",CRONEXP:"30 8,20 * * *",TIMEOUT:300
#!arguments-desc=- 是否开启抓取重写：此值即请求匹配正则。开启=保持默认 URL 正则；关闭=改成 #（抓完务必改成 #）。不要填「PingMe抓参」文字。\n\n- CRONEXP: 签到定时，默认每天 8:30 与 20:30。\n\n- TIMEOUT: 签到超时秒数，默认 300。

[Script]
PingMe获取参数 = type=http-request,pattern={{{是否开启抓取重写}}},script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/PingMe-capture.js,timeout=60

PingMe签到 = type=cron,cronexp="{{{CRONEXP}}}",script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/PingMe-signin.js,timeout={{{TIMEOUT}}}

[MITM]
hostname = %APPEND% api.pingmeapp.net
