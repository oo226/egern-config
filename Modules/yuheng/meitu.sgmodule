# mirrored from Yuheng0101/X — script-path → 本仓 Scripts/yuheng/（防删库）；模版参数保留
#!name=美图欣赏
#!author=Yuheng0101[https://github.com/Yuheng0101]
#!homepage=https://github.com/Yuheng0101/X
#!desc=多看美图助于身心健康😊

[Script]
meitu = type=http-request, pattern=^https?:\/\/mei\.tu, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/yuheng/Tasks/meitu/meitu.js, requires-body=true, max-size=-1, timeout=60

美图鉴赏 = type=cron, cronexp="30 20 * * *", script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/yuheng/Tasks/meitu/meitu.js, timeout=120, wake-system=1

[MITM]
hostname = %APPEND% mei.tu