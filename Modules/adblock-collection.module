[Header Rewrite]

# >>> merged from limbopro-web-ads (unique only)
^https?:\/\/(www\.xvideos)(\.)(\w{0,3})(?!(.*(api|cdn-cgi|verify|auth|captch|\.))).* header-replace Content-Security-Policy *


# >>> merged from qingrex-adblock (unique only)

# >>> merged from Beta/小蚕霸王餐去广告.beta.sgmodule (unique only)
http-request ^https:\/\/gw\.xiaocantech\.com\/rpc header-replace-regex 'methodname' '.*(GetBannerList|IsShowOrderAwardPopup|UserLifeShopList|BrandBannerList|GetPromotionGlobalCfg)' 'null'


# >>> merged from Official/Reddit 去广告.sgmodule (unique only)
{{{TRANSLATION}}} ^https:\/\/gql(-fed)?\.reddit\.com\/ header-del x-reddit-translations
{{{TRANSLATION}}} ^https:\/\/gql(-fed)?\.reddit\.com\/ header-add x-reddit-translations "{{{TRANSLATION_VALUE}}}"

# >>> merged from Official/SDGun 社区 Tablet 访问.sgmodule (unique only)

http-request ^https?:\/\/bbs\.sdgun\.com\.cn header-del User-Agent
http-request ^https?:\/\/bbs\.sdgun\.com\.cn header-add User-Agent "Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1 Edg/135.0.0.0"



# >>> merged from 小蚕霸王餐去广告.sgmodule (unique only)

# >>> merged from fmz200-extra (unique only)

# >>> merged from bilibili.sgmodule (unique only)
http-response ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(interface\.v1\.(Teenagers\/ModeStatus|Search\/DefaultWords)|view\.v1\.View\/TFInfo|viewunite\.v1\.View\/ViewEndPage)$ header-add 'grpc-status' '0'
