#!name=Spotify(>=iOS15)
#!desc=部分解锁 Premium：去广告、歌手/专辑列表、去随机播放（与 wesselyang/spotify.plugin 同款；音质勿设超高；登录后开模块并强杀重启 App）
#!openUrl=https://github.com/app2smile/rules
#!author=oo226/egern-config (upstream: wesselyang / Amlabort Eevee)
#!category=解锁
#!system=ios

# 严格对齐 https://raw.githubusercontent.com/wesselyang/rules/master/plugin/spotify.plugin
# 仅 customize 去 If-None-Match；脚本用 Eevee spot-proto-eevee（本仓镜像防失效）

[URL Rewrite]
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
spotifyProto = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, requires-body=true, binary-body-mode=true, max-size=0, timeout=10, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/_external/github-raw/Amlabort/MY_clash/main/files/lpx/js/spot-proto-eevee.js
