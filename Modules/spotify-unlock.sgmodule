#!name=Spotify Unlock (Eevee)
#!desc=部分解锁 Premium：去广告、去随机播放、列表正常（对照 wesselyang/spotify.plugin；音质勿设超高；登录后开模块并强杀重启 App）
#!author=oo226/egern-config (Eevee + app2smile header)
#!category=解锁
#!system=ios

[URL Rewrite]
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ header-del if-none-match
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ header-del if-modified-since

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ header-del If-None-Match
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ header-del If-Modified-Since

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *-spclient.spotify.com, *spclient.spotify.com

[Script]
# 与 app2smile QuanX 同款：请求头脚本删 If-None-Match，避免 304
spotifyProto-nocache = type=http-request, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/spotify-del-cache-headers.js, timeout=10

spotifyProto = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, requires-body=true, binary-body-mode=true, max-size=0, timeout=10, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/_external/github-raw/Amlabort/MY_clash/main/files/lpx/js/spot-proto-eevee.js

spotify-json = type=http-request, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/, requires-body=0, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/_external/github-raw/app2smile/rules/master/js/spotify-json.js
