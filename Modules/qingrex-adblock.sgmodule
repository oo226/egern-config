[Header Rewrite]

# >>> merged from Beta/小蚕霸王餐去广告.beta.sgmodule (unique only)
http-request ^https:\/\/gw\.xiaocantech\.com\/rpc header-replace-regex 'methodname' '.*(GetBannerList|IsShowOrderAwardPopup|UserLifeShopList|BrandBannerList|GetPromotionGlobalCfg)' 'null'


# >>> merged from Official/Reddit 去广告.sgmodule (unique only)
{{{TRANSLATION}}} ^https:\/\/gql(-fed)?\.reddit\.com\/ header-del x-reddit-translations
{{{TRANSLATION}}} ^https:\/\/gql(-fed)?\.reddit\.com\/ header-add x-reddit-translations "{{{TRANSLATION_VALUE}}}"

# >>> merged from Official/SDGun 社区 Tablet 访问.sgmodule (unique only)

