#!name=皮皮虾去广告补全
#!desc=只净化信息流广告；不用 aid=1412 header（会弄丢评论回复）。清缓存后更稳。
#!author=oo226/egern-config (脚本基于 Liquor030/NobyDa Super.js)
#!category=去广告补全
#!system=ios

[Script]
# 仅信息流。不用 app_name/aid header 全局改写（会让评论回复变空）
皮皮虾信息流 = type=http-response, pattern=^https?:\/\/[^\/]*\.(snssdk|pipix)\.com\/bds\/feed\/(stream|channel_list), script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/pipixia/ppx_ads.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com
