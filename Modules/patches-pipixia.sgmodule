#!name=皮皮虾去广告补全
#!desc=stream/detail 去广告去水印；Map Local 拦 banner/ad；check_in 改走 Egern yaml 静音处理（避免狂刷日志）。
#!author=oo226/egern-config (Super.js + QingRex/可莉 + ZenmoFeiShi)
#!category=去广告补全
#!system=ios

[URL Rewrite]
# 原 chxm1023 把 bds 和 monitor/trace/log 写在一起，会 reject 掉皮皮虾整站 API。
^https?:\/\/.*\.snssdk\.com\/(monitor|trace|log).* - reject

[Map Local]
# 开屏/运营位/推荐上方入口常见来源（可莉模块同款）
^https?:\/\/[^\/]*\.pipix\.com\/api\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/banner\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
# 不含 check_in：该接口几秒一次，挂 Script 会把日志刷爆
# 含 stream/v2、channel_list、detail
皮皮虾 = type=http-response, pattern=^https?:\/\/[^\/]*\.(snssdk|pipix)\.com\/bds\/(feed\/(stream|channel_list)|cell\/detail), script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/pipixia/ppx_ads.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com, api.pipix.com, api5-lq.pipix.com
