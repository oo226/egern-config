#!name=皮皮虾去广告补全
#!desc=合集内：无 Script。Map Local 空掉 banner/tail_cards/luckycat；Body Rewrite 处理 stream/check_in（Surge）。Egern 另用主配置 response_jq。
#!author=oo226/egern-config (可莉 + Super.js + ZenmoFeiShi)
#!category=去广告补全
#!system=ios

[URL Rewrite]
^https?:\/\/.*\.snssdk\.com\/(monitor|trace|log).* - reject

[Map Local]
# 开屏/运营 banner（日志里已是 ~50B 空包；给合法空结构避免客户端走缓存）
^https?:\/\/[^\/]*\.pipix\.com\/api\/ad\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/banner\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"banner\":[],\"banners\":[],\"list\":[],\"banner_list\":[]}}" status-code=200 header="Content-Type:application/json"
# 播完尾巴推荐卡
^https?:\/\/[^\/]*\.pipix\.com\/bds\/cell\/tail_cards data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"cards\":[],\"list\":[],\"data\":[]}}" status-code=200 header="Content-Type:application/json"
# 金币/小组件配置
^https?:\/\/[^\/]*\.pipix\.com\/luckycat\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
# 信息流：去广告 + 去掉无正文/视频的入口卡（推荐上方圆形入口）+ 去水印
http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/feed\/stream 'def unlock: if (.item.video? and .item.origin_video_download.url_list?) then .item.video.video_download.url_list=.item.origin_video_download.url_list else . end; def keep: (has("ad_info")|not) and (has("banner_info")|not) and (has("item")) and ((.item.video!=null) or (.item.content!=null) or (.item.note!=null) or (.item.image_list!=null)); .data.data |= map(select(keep) | unlock) | if .data.channel_model then .data.channel_model |= map(select(.event_name=="feed" or .event_name=="image_text" or .event_name=="follow_feed")) else . end | del(.data.story_list,.data.circle_list,.data.live_list,.data.banner_list,.data.header_list,.data.square_list,.data.cinema_list,.data.recommend_users,.data.user_story,.data.slide_list,.data.icon_list,.data.entrance_list,.data.top_list,.data.quick_access)'

http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/feed\/channel_list '(if .data.channel_model then .data.channel_model |= map(select(.event_name=="feed" or .event_name=="image_text" or .event_name=="follow_feed")) else . end) | del(.data.story_list,.data.circle_list,.data.live_list,.data.banner_list,.data.header_list,.data.square_list,.data.cinema_list,.data.recommend_users,.data.user_story,.data.slide_list,.data.icon_list,.data.entrance_list,.data.top_list,.data.quick_access)'

http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/user\/check_in '(if .data.profile_entrances then .data.profile_entrances |= map(select(.title != "放心借" and .title != "洋钱罐借款" and .title != "创作中心" and .title != "原创特权" and .title != "小黑屋" and .title != "我的订单" and .title != "银行卡管理" and .title != "神评鉴定" and .title != "宠物乐园" and .title != "进入宠物乐园")) else . end) | del(.data.pet_interface_message,.data.pet_entrance,.data.pet_paradise,.data.activity_banner,.data.profile_banner,.data.loan_entrance,.data.credit_entrance)'

http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/cell\/detail 'if (.data.item.video? and .data.item.origin_video_download.url_list?) then .data.item.video.video_download.url_list=.data.item.origin_video_download.url_list else . end'

http-response ^https?:\/\/[^\/]*\.pipix\.com\/bds\/(feed\/stream|cell\/detail) tplv-ppx-logo.image 0x0.gif
http-response ^https?:\/\/[^\/]*\.pipix\.com\/bds\/(feed\/stream|cell\/detail) tplv-ppx-logo 0x0
http-response ^https?:\/\/[^\/]*\.pipix\.com\/bds\/(feed\/stream|cell\/detail) "can_download":false "can_download":true

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com, api.pipix.com, api5-lq.pipix.com
