#!name=皮皮虾去广告补全
#!desc=信息流去广告 + 去水印 +「我的」/频道精简。用 Script（Egern 可跑）；不用 jq（Egern 常不生效）。不用 aid=1412。不碰评论接口。
#!author=oo226/egern-config (Super.js + ZenmoFeiShi PPX.js)
#!category=去广告补全
#!system=ios

[URL Rewrite]
# 原 chxm1023 把 bds 和 monitor/trace/log 写在一起，会 reject 掉皮皮虾整站 API。
# 这里只拦真正的埋点路径（合集已排除错误那一行）。
^https?:\/\/.*\.snssdk\.com\/(monitor|trace|log).* - reject

[Script]
# 仅 feed / check_in / detail，避免评论接口刷日志；显式 status 减轻 status=0
皮皮虾 = type=http-response, pattern=^https?:\/\/[^\/]*\.(snssdk|pipix)\.com\/bds\/(feed\/(stream|channel_list)|user\/check_in|cell\/detail), script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/pipixia/ppx_ads.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com
