#!name=皮皮虾去广告补全
#!desc=Egern 必须用 Script（合集 jq 常无效）。stream/channel/check_in/detail/settings 清理；Map Local 空广告/banner/luckycat。显式 status 减轻「状态 0」。
#!author=oo226/egern-config (Super.js + ZenmoFeiShi)
#!category=去广告补全
#!system=ios

[URL Rewrite]
^https?:\/\/.*\.snssdk\.com\/(monitor|trace|log).* - reject

[Map Local]
# 开屏/运营/弹窗/金币接口：空包即可，不进 Script 日志
^https?:\/\/[^\/]*\.pipix\.com\/api\/ad\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/banner\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"banner\":[],\"banners\":[],\"list\":[],\"banner_list\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/hashtag\/get_top_hashtag data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"hashtag_list\":[],\"hashtags\":[],\"list\":[],\"data\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/popups\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/medal\/popups data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/cell\/tail_cards data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"cards\":[],\"list\":[],\"data\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/luckycat\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

[Script]
# max-size=-1：stream 常 300KB+。含 check_in：Egern 上 jq 清不了「我的」。
# 含 settings：尽量去掉底部「福利」。
ppx = type=http-response, pattern=^https?:\/\/[^\/]*\.(snssdk|pipix)\.com\/(bds\/(feed\/(stream|channel_list)|user\/check_in|cell\/detail|settings\/)|service\/settings\/), requires-body=1, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/pipixia/ppx_ads.js

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com, api.pipix.com, api5-lq.pipix.com
