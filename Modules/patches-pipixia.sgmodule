#!name=皮皮虾去广告补全
#!desc=Super.js 去水印 + 可莉 Map Local + Script 清 stream/我的/福利 Tab。Surge/Egern 均走合集，无需改主配置。
#!author=oo226/egern-config (NobyDa Super.js + QingRex/可莉 + ZenmoFeiShi)
#!category=去广告补全
#!system=ios

[URL Rewrite]
^https?:\/\/.*\.snssdk\.com\/(monitor|trace|log).* - reject

[Map Local]
# api(5-lq)? 对齐可莉 hub.kelee.one；空合法 JSON 避免客户端走旧缓存
^https?:\/\/api(5-lq)?\.pipix\.com\/api\/ad\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/banner\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"banner\":[],\"banners\":[],\"list\":[],\"banner_list\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/hashtag\/get_top_hashtag data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"hashtag_list\":[],\"hashtags\":[],\"list\":[],\"data\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/popups\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/medal\/popups data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/cell\/tail_cards data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":{\"cards\":[],\"list\":[],\"data\":[]}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/feed\/follow_feed\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/api(5-lq)?\.pipix\.com\/luckycat\/ data-type=text data="{\"status_code\":0,\"message\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

[Script]
# 主路径：feed / 我的 / 设置(去福利Tab) / detail — max-size=-1 因 stream/v2 常 300KB+
ppx = type=http-response, pattern=^https?:\/\/[^\/]*\.(snssdk|pipix)\.com\/(bds\/(feed\/(stream|channel_list)|user\/check_in|cell\/detail|settings\/)|service\/settings\/), requires-body=1, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/pipixia/ppx_ads.js
# Super.js 遗留路径：评论/插眼/收藏等（仍在 snssdk 域）
ppx-extra = type=http-response, pattern=^https?:\/\/[^\/]*\.snssdk\.com\/bds\/(comment\/cell_reply|cell\/cell_comment|ward\/list|user\/favorite|user\/cell_coment|user\/cell_userfeed|user\/publish_list), requires-body=1, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/oo226/egern-config/refs/heads/main/Scripts/pipixia/ppx_ads.js

[Body Rewrite]
# Surge 备用：Script 未命中时 jq 仍可做基础去 ad_info（Egern 上 jq 常无效，靠 Script）
http-response-jq ^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/feed\/stream 'def unlock: if (.item.video? and .item.origin_video_download.url_list?) then .item.video.video_download.url_list=.item.origin_video_download.url_list else . end; def keep: (has("ad_info")|not) and (has("banner_info")|not) and (has("item")) and ((.item.video!=null) or (.item.content!=null) or (.item.note!=null) or (.item.image_list!=null)); .data.data |= map(select(keep) | unlock) | if .data.channel_model then .data.channel_model |= map(select(.event_name=="feed" or .event_name=="image_text" or .event_name=="follow_feed")) else . end | del(.data.story_list,.data.circle_list,.data.live_list,.data.banner_list,.data.header_list,.data.square_list,.data.cinema_list,.data.recommend_users,.data.user_story,.data.slide_list,.data.icon_list,.data.entrance_list,.data.top_list,.data.quick_access)'

http-response-jq ^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/user\/check_in '(if .data.profile_entrances then .data.profile_entrances |= map(select(.title != "放心借" and .title != "洋钱罐借款" and .title != "创作中心" and .title != "原创特权" and .title != "小黑屋" and .title != "我的订单" and .title != "银行卡管理" and .title != "神评鉴定" and .title != "宠物乐园" and .title != "进入宠物乐园")) else . end) | del(.data.pet_interface_message,.data.pet_entrance,.data.pet_paradise,.data.activity_banner,.data.profile_banner,.data.loan_entrance,.data.credit_entrance)'

http-response ^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/(feed\/stream|cell\/detail) tplv-ppx-logo.image 0x0.gif
http-response ^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/(feed\/stream|cell\/detail) tplv-ppx-logo 0x0
http-response ^https?:\/\/api(5-lq)?\.pipix\.com\/bds\/(feed\/stream|cell\/detail) "can_download":false "can_download":true

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com, api.pipix.com, api5-lq.pipix.com
