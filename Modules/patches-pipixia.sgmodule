#!name=皮皮虾去广告补全
#!desc=合集内完成：无 Script（不刷 Egern 日志）。stream 去广告/圆形入口/去水印；check_in「我的」精简；banner/ad 本地空响应。
#!author=oo226/egern-config (可莉 + Super.js + ZenmoFeiShi)
#!category=去广告补全
#!system=ios

[URL Rewrite]
# 原 chxm1023 把 bds 和 monitor/trace/log 写在一起，会 reject 掉皮皮虾整站 API。
^https?:\/\/.*\.snssdk\.com\/(monitor|trace|log).* - reject

[Map Local]
# 开屏 / 运营 banner（可莉同款）— 无脚本、无日志
^https?:\/\/[^\/]*\.pipix\.com\/api\/ad\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
^https?:\/\/[^\/]*\.pipix\.com\/bds\/banner\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Body Rewrite]
# 信息流：去广告 + 只留带 item 的正常帖（推荐上方圆形入口通常无 item）+ 去水印解锁
http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/feed\/stream 'def unlock: if (.item.video? and .item.origin_video_download.url_list?) then .item.video.video_download.url_list=.item.origin_video_download.url_list else . end; .data.data |= map(select((has("ad_info")|not) and (has("banner_info")|not) and (has("item"))) | unlock) | if .data.channel_model then .data.channel_model |= map(select(.event_name=="feed" or .event_name=="image_text" or .event_name=="follow_feed")) else . end | del(.data.story_list,.data.circle_list,.data.live_list,.data.banner_list,.data.header_list,.data.square_list,.data.cinema_list,.data.recommend_users,.data.user_story,.data.slide_list)'

# 频道栏精简
http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/feed\/channel_list '(if .data.channel_model then .data.channel_model |= map(select(.event_name=="feed" or .event_name=="image_text" or .event_name=="follow_feed")) else . end) | del(.data.story_list,.data.circle_list,.data.live_list,.data.banner_list,.data.header_list,.data.square_list,.data.cinema_list,.data.recommend_users,.data.user_story,.data.slide_list)'

# 「我的」页精简（不进 Script 日志）
http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/user\/check_in '(if .data.profile_entrances then .data.profile_entrances |= map(select(.title != "放心借" and .title != "洋钱罐借款" and .title != "创作中心" and .title != "原创特权" and .title != "小黑屋" and .title != "我的订单" and .title != "银行卡管理" and .title != "神评鉴定" and .title != "宠物乐园" and .title != "进入宠物乐园")) else . end) | del(.data.pet_interface_message,.data.pet_entrance,.data.pet_paradise,.data.activity_banner,.data.profile_banner,.data.loan_entrance,.data.credit_entrance)'

# 详情页去水印解锁
http-response-jq ^https?:\/\/[^\/]*\.pipix\.com\/bds\/cell\/detail 'if (.data.item.video? and .data.item.origin_video_download.url_list?) then .data.item.video.video_download.url_list=.data.item.origin_video_download.url_list else . end'

# 正文兜底：logo 水印 / 可下载（片中剧名水印无法去）
http-response ^https?:\/\/[^\/]*\.pipix\.com\/bds\/(feed\/stream|cell\/detail) tplv-ppx-logo.image 0x0.gif
http-response ^https?:\/\/[^\/]*\.pipix\.com\/bds\/(feed\/stream|cell\/detail) tplv-ppx-logo 0x0
http-response ^https?:\/\/[^\/]*\.pipix\.com\/bds\/(feed\/stream|cell\/detail) "can_download":false "can_download":true

[MITM]
hostname = %APPEND% *.snssdk.com, *.pipix.com, api.pipix.com, api5-lq.pipix.com
