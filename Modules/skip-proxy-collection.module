#!name=跳过代理检测合集
#!desc=mieqq + Sukka Always Real IP + iamsweet 等合并去重（每日扫描更新）。银行/交管等 App 跳过代理检测用这一份即可。
#!category=代理检测
#!tag=skip-proxy,always-real-ip,合集
# sources: iamsweet-skip-proxy、mieqq-skip-proxy、sukka-always-realip
# AUTO-GENERATED by scripts/discover-proxy-detect.py — do not edit

[General]
skip-proxy = %APPEND% yunbusiness.ccb.com, www.abchina.com.cn, login-service.mobile-bank.psbc.com, mobile-bank.psbc.com, www.baidu.com, wxh.wo.cn, gate.lagou.com, www.shanbay.com, id6.me, www.163.com
always-real-ip = %APPEND% easy-login.10099.com.cn, *-update.xoyocdn.com, id6.me, open.e.189.cn, dns.msftncsi.com, *.srv.nintendo.net, *.stun.playstation.net, xbox.*.microsoft.com, *.xboxlive.com, *.turn.twilio.com, *.stun.twilio.com, stun.syncthing.net, stun.*, lancache.steamcontent.com

[Rule]
DOMAIN,msmp.abchina.com.cn,REJECT
